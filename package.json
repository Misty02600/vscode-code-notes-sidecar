{
  "name": "code-notes-sidecar",
  "displayName": "Code Notes Sidecar",
  "description": "Read non-invasive, range-based source annotations in a synchronized preview beside the real editor.",
  "version": "0.7.1",
  "publisher": "misty02600",
  "license": "MIT",
  "homepage": "https://github.com/Misty02600/vscode-code-notes-sidecar#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Misty02600/vscode-code-notes-sidecar.git"
  },
  "bugs": {
    "url": "https://github.com/Misty02600/vscode-code-notes-sidecar/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "annotation",
    "documentation",
    "preview",
    "source code"
  ],
  "activationEvents": [
    "workspaceContains:.code-notes/**/*.json",
    "workspaceContains:.vscode/source-annotations/**/*.json"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codeNotesSidecar.openPreviewToSide",
        "title": "Open Annotation Preview to the Side",
        "category": "Code Notes Sidecar",
        "icon": "$(open-preview)"
      },
      {
        "command": "codeNotesSidecar.togglePreviewLock",
        "title": "Toggle Annotation Preview Lock",
        "category": "Code Notes Sidecar"
      },
      {
        "command": "codeNotesSidecar.reloadAnnotations",
        "title": "Reload Annotations",
        "category": "Code Notes Sidecar",
        "icon": "$(refresh)"
      },
      {
        "command": "codeNotesSidecar.copyAnnotationStub",
        "title": "Copy Annotation Stub for Selection",
        "category": "Code Notes Sidecar"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codeNotesSidecar.openPreviewToSide",
          "group": "navigation@90",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "codeNotesSidecar.openPreviewToSide",
          "group": "navigation@89",
          "when": "resourceScheme == file"
        },
        {
          "command": "codeNotesSidecar.copyAnnotationStub",
          "group": "navigation@90",
          "when": "editorHasSelection && resourceScheme == file"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeNotesSidecar.openPreviewToSide",
        "key": "ctrl+k a",
        "mac": "cmd+k a",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ],
    "configuration": {
      "title": "Code Notes Sidecar",
      "properties": {
        "codeNotesSidecar.annotationGlob": {
          "type": "string",
          "default": ".code-notes/**/*.json",
          "description": "Workspace-relative glob used to discover annotation documents. The default also discovers the legacy .vscode/source-annotations location."
        },
        "codeNotesSidecar.scrollSync": {
          "type": "string",
          "enum": [
            "off",
            "editorToPreview",
            "bidirectional"
          ],
          "enumDescriptions": [
            "Disable synchronized scrolling.",
            "Scrolling the source editor moves the annotation preview.",
            "The source editor and annotation preview move each other."
          ],
          "default": "bidirectional",
          "description": "Controls synchronized scrolling between source and preview."
        },
        "codeNotesSidecar.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Update an unlocked preview when the active source editor changes."
        },
        "codeNotesSidecar.cardLayout": {
          "type": "string",
          "enum": [
            "sourceAligned",
            "compact"
          ],
          "enumDescriptions": [
            "Preserve relative source-line spacing between cards without leading page whitespace.",
            "Stack cards without adding source-line spacing."
          ],
          "default": "sourceAligned",
          "description": "Controls the vertical layout of annotation cards."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "/.code-notes/*.json",
          "/.code-notes/**/*.json",
          "/.vscode/source-annotations/*.json",
          "/.vscode/source-annotations/**/*.json"
        ],
        "url": "./schemas/source-annotations.schema.json"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "smoke": "node scripts/smoke-bundle.cjs && node --check media/preview.js",
    "package:vsix": "vsce package --out release/code-notes-sidecar.vsix",
    "package": "npm run check && npm run test && npm run build && npm run smoke && npm run package:vsix"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.1",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
